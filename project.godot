; Wizards on a Boat — Godot 4
config_version=5

[application]
config/name="Wizards on a Boat"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="A shared sea of spells, sails and strange islands."

[autoload]
Session="*res://scripts/net/session.gd"

[display]
window/size/viewport_width=1536
window/size/viewport_height=1024
window/size/window_width_override=1280
window/size/window_height_override=854
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12,0.42,0.67,1)

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[audio]
driver/enable_input=false

